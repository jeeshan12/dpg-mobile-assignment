{
  "name": "video-qa-challenge-tests",
  "version": "1.0.0",
  "private": false,
  "description": "Cross-platform (Android + iOS) Appium/WebdriverIO/TypeScript test suite",
  "scripts": {
    "pretest": "bash scripts/fetch-apps.sh",
    "test": "wdio run ./config/wdio.all.conf.ts",
    "pretest:android": "bash scripts/fetch-apps.sh",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "pretest:ios": "bash scripts/fetch-apps.sh",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "appium:farm": "appium --config config/appium-device-farm.json",
    "pretest:farm": "bash scripts/fetch-apps.sh",
    "test:farm": "wdio run ./config/wdio.devicefarm.conf.ts",
    "pretest:farm:android": "bash scripts/fetch-apps.sh",
    "test:farm:android": "PLATFORM=android wdio run ./config/wdio.devicefarm.conf.ts",
    "pretest:farm:ios": "bash scripts/fetch-apps.sh",
    "test:farm:ios": "PLATFORM=ios wdio run ./config/wdio.devicefarm.conf.ts",
    "lint": "eslint \"src/**/*.ts\" \"config/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"config/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "~22.20.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@wdio/allure-reporter": "~9.5.0",
    "@wdio/appium-service": "~9.5.0",
    "@wdio/cli": "~9.5.0",
    "@wdio/junit-reporter": "~9.5.0",
    "@wdio/local-runner": "~9.5.0",
    "@wdio/mocha-framework": "~9.5.0",
    "@wdio/spec-reporter": "~9.5.0",
    "@wdio/types": "~9.5.0",
    "allure-commandline": "^2.43.0",
    "appium": "~3.7.0",
    "appium-device-farm": "~12.0.1",
    "appium-uiautomator2-driver": "~8.6.1",
    "appium-xcuitest-driver": "~12.11.1",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "~9.1.2",
    "eslint-plugin-wdio": "~8.37.0",
    "husky": "~9.1.7",
    "lint-staged": "~15.5.2",
    "prettier": "~3.9.6",
    "typescript": "~5.5.4"
  },
  "overrides": {
    "bplist-parser": "0.3.2"
  }
}